{
  "name": "@local/dsh-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local memory for DeepSeek Harness: markdown memory files (MEMORY.md / USER.md) plus a holographic fact store, with a 记忆 page in the desktop UI.",
  "scripts": {
    "dl-model": "node dl-model.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "devDependencies": {
    "node-llama-cpp": "^3.22.3"
  }
}
