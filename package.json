{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "本地记忆插件 for DeepSeek Harness：Markdown 双层记忆 + Holographic 事实库，零 npm 依赖，全离线。Local memory plugin for DeepSeek Harness with holographic fact store.",
  "type": "module",
  "license": "MIT",
  "author": "kiterli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiterli/dsh-memory.git"
  },
  "bugs": {
    "url": "https://github.com/kiterli/dsh-memory/issues"
  },
  "homepage": "https://github.com/kiterli/dsh-memory#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "holographic",
    "hrr",
    "vector-search",
    "local-first",
    "offline"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/*.test.mjs\"",
    "dl-model": "node dl-model.mjs",
    "screenshot": "node dev/screenshot.cjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "devDependencies": {
    "node-llama-cpp": "^3.22.3"
  }
}
